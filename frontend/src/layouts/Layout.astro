---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'WiFi Radar — Atheros AR9271 Presence Detection' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-[#fafafa] text-zinc-900 min-h-screen antialiased selection:bg-zinc-900 selection:text-white">
    <slot />
  </body>
</html>
